select
--
SELECT id, CONVERT(VARCHAR(40), bdt, 140), CONVERT(VARCHAR(40), bt, 140), CONVERT(VARCHAR(40), d, 140),
	CONVERT(VARCHAR(40), t, 140), CONVERT(VARCHAR(40), dt, 140)
FROM all_types_bcp_unittest ORDER BY id
