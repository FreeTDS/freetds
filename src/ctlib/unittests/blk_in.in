--
sql
--
CREATE TABLE all_types_bcp_unittest (
	si smallint NOT NULL
)
--
bind
--
CS_CHAR_TYPE	10	123
SENDROW
-- truncated data
CS_CHAR_TYPE	10	hello
SENDROWERROR	CLIENT2	0x102011a	Failed in conversion routine - syntax error.  col = 1 row = 2
CS_CHAR_TYPE	10	12345678
SENDROWERROR	CLIENT2	0x1020119	Failed in conversion routine - condition overflow.  col = 1 row = 2
CS_CHAR_TYPE	10	45
--
output
--
123
45
--
sql
--
CREATE TABLE all_types_bcp_unittest (
	not_null_varbinary varbinary(3) NOT NULL
)
--
bind
--
CS_CHAR_TYPE	10	"""  0x313233"""
SENDROW
-- truncated data
CS_CHAR_TYPE	10	"""	0x32333435"""
SENDROW	CLIENT2	0x102012a	Data truncated while doing local character set conversion.  col = 1 row = 2
-- truncated data are not checked for hexadecimal
CS_CHAR_TYPE	10	0x313241zz
SENDROW	CLIENT2	0x102012a	Data truncated while doing local character set conversion.  col = 1 row = 3
-- data with errors
CS_CHAR_TYPE	10	0x3132zz
SENDROWERROR	CLIENT2	0x102011a	Failed in conversion routine - syntax error.  col = 1 row = 4
-- not multiple of 2, 0 nibble added
CS_CHAR_TYPE	10	31324zz
SENDROW	CLIENT2	0x102012a	Data truncated while doing local character set conversion.  col = 1 row = 4
CS_CHAR_TYPE	10	0x414243
--
output
--
313233
323334
313241
031324
414243
--
sql
--
-- data too long for a character column, behaviour depends on source type
CREATE TABLE all_types_bcp_unittest (
	  id		int NOT NULL
	, vc		varchar(3) NULL
)
--
bind
--
-- character data are truncated
CS_CHAR_TYPE	10	1
CS_CHAR_TYPE	10	abcd
SENDROW
CS_CHAR_TYPE	10	2
CS_LONGCHAR_TYPE	10	abcd
SENDROW
-- CS_VARCHAR is truncated with a warning
CS_CHAR_TYPE	10	3
CS_VARCHAR_TYPE	10	abcd
SENDROW	CLIENT2	0x102012a	Data truncated while doing local character set conversion.  col = 2 row = 3
-- binary is truncated with a warning, not splitting hexadecimal digits of a byte
CS_CHAR_TYPE	10	4
CS_BINARY_TYPE	10	0x010203
SENDROW	CLIENT2	0x102012a	Data truncated while doing local character set conversion.  col = 2 row = 4
CS_CHAR_TYPE	10	5
CS_LONGBINARY_TYPE	10	0x010203
SENDROW	CLIENT2	0x102012a	Data truncated while doing local character set conversion.  col = 2 row = 5
-- CS_VARBINARY fails
CS_CHAR_TYPE	10	6
CS_VARBINARY_TYPE	10	0x010203
SENDROWERROR	CLIENT2	0x1020119	Failed in conversion routine - condition overflow.  col = 2 row = 6
-- dates are truncated with a warning
CS_CHAR_TYPE	10	6
CS_DATETIME_TYPE	8	2024-05-10 12:34:56
SENDROW	CLIENT2	0x102012a	Data truncated while doing local character set conversion.  col = 2 row = 6
-- numbers fail
CS_CHAR_TYPE	10	7
CS_INT_TYPE	4	1234
SENDROWERROR	CLIENT2	0x1020119	Failed in conversion routine - condition overflow.  col = 2 row = 7
-- data fitting the column
CS_CHAR_TYPE	10	7
CS_INT_TYPE	4	123
SENDROW
CS_CHAR_TYPE	10	8
CS_VARBINARY_TYPE	10	0x01
--
select
--
SELECT id, vc FROM all_types_bcp_unittest ORDER BY id
--
output
--
1
abc
2
abc
3
abc
4
01
5
01
6
May
7
123
8
01
--
sql
--
-- data too long for a binary column, behaviour depends on source type
CREATE TABLE all_types_bcp_unittest (
	  id		int NOT NULL
	, vb		varbinary(2) NULL
)
--
bind
--
-- character data are truncated with a warning
CS_CHAR_TYPE	10	1
CS_CHAR_TYPE	10	0x010203
SENDROW	CLIENT2	0x102012a	Data truncated while doing local character set conversion.  col = 2 row = 1
-- CS_VARCHAR fails
CS_CHAR_TYPE	10	2
CS_VARCHAR_TYPE	10	0x010203
SENDROWERROR	CLIENT2	0x1020119	Failed in conversion routine - condition overflow.  col = 2 row = 2
-- binary is truncated
CS_CHAR_TYPE	10	2
CS_BINARY_TYPE	10	0x010203
SENDROW
-- long binary is truncated with a warning
CS_CHAR_TYPE	10	3
CS_LONGBINARY_TYPE	10	0x010203
SENDROW	CLIENT2	0x102012a	Data truncated while doing local character set conversion.  col = 2 row = 3
-- CS_VARBINARY fails
CS_CHAR_TYPE	10	4
CS_VARBINARY_TYPE	10	0x010203
SENDROWERROR	CLIENT2	0x1020119	Failed in conversion routine - condition overflow.  col = 2 row = 4
-- numbers are truncated with a warning (bytes are the same in any byte order)
CS_CHAR_TYPE	10	4
CS_INT_TYPE	4	16843009
SENDROW	CLIENT2	0x102012a	Data truncated while doing local character set conversion.  col = 2 row = 4
-- data fitting the column
CS_CHAR_TYPE	10	5
CS_VARBINARY_TYPE	10	0x0102
--
select
--
SELECT id, vb FROM all_types_bcp_unittest ORDER BY id
--
output
--
1
0102
2
0102
3
0102
4
0101
5
0102
--
sql
--
-- fixed length types bound without specifying length (CS_UNUSED)
CREATE TABLE all_types_bcp_unittest (
	  id		int NOT NULL
	, dt		datetime NULL
	, n		numeric(10,2) NULL
	, vc		varchar(40) NULL
)
--
bind
--
CS_CHAR_TYPE	10	1
CS_DATE_TYPE	UNUSED	2024-05-10
CS_NUMERIC_TYPE	UNUSED	12345.67
CS_TIME_TYPE	UNUSED	12:34:56.123
SENDROW
CS_CHAR_TYPE	10	2
CS_BIGDATETIME_TYPE	UNUSED	2024-05-10 12:34:56.500000
CS_NUMERIC_TYPE	UNUSED	-1.5
CS_BIGTIME_TYPE	UNUSED	12:34:56.123456
--
select
--
SELECT id, CONVERT(VARCHAR(30), dt, 109), n, vc FROM all_types_bcp_unittest ORDER BY id
--
output
--
1
May 10 2024 12:00:00:000AM
12345.67
12:34PM
2
May 10 2024 12:34:56:500PM
-1.50
12:34PM
--
sql
--
-- conversion errors on nullable columns must fail the row, not insert NULL
-- errors are in the first rows as column data are initially NULL
CREATE TABLE all_types_bcp_unittest (
	  nullable_varbinary	varbinary(3) NULL
	, nullable_int		int NULL
)
--
bind
--
CS_CHAR_TYPE	10	hello
CS_CHAR_TYPE	10	1
SENDROWERROR	CLIENT2	0x102011a	Failed in conversion routine - syntax error.  col = 1 row = 1
CS_CHAR_TYPE	10	0x41
CS_CHAR_TYPE	10	abc
SENDROWERROR	CLIENT2	0x102011a	Failed in conversion routine - syntax error.  col = 2 row = 1
CS_CHAR_TYPE	10	0x313233
CS_CHAR_TYPE	10	1
SENDROW
CS_CHAR_TYPE	10	0x42
CS_CHAR_TYPE	10	4
--
select
--
SELECT nullable_varbinary, nullable_int FROM all_types_bcp_unittest ORDER BY nullable_int
--
output
--
313233
1
42
4
--
sql
--
-- before TDS 7.3 these columns are seen as NVARCHAR, so binding
-- date/time types is not supported, skip the test
IF (SELECT protocol_version FROM sys.dm_exec_connections WHERE session_id = @@SPID) < 1929379840
	RAISERROR('Date types require TDS 7.3', 16, 1)
ELSE
CREATE TABLE all_types_bcp_unittest (
	  id		int NOT NULL
	, d		date NULL
	, t		time NULL
	, dt2		datetime2 NULL
	, dt2_3		datetime2(3) NULL
	, dto		datetimeoffset NULL
)
--
bind
--
CS_CHAR_TYPE	10	1
CS_DATETIME_TYPE	8	2024-05-10 12:34:56.500
CS_DATETIME_TYPE	8	2024-05-10 12:34:56.500
CS_DATETIME_TYPE	8	2024-05-10 12:34:56.500
CS_DATETIME_TYPE	8	2024-05-10 12:34:56.500
CS_DATETIME_TYPE	8	2024-05-10 12:34:56.500
SENDROW
CS_CHAR_TYPE	10	2
CS_BIGDATETIME_TYPE	8	2024-05-10 12:34:56.123456
CS_BIGDATETIME_TYPE	8	2024-05-10 12:34:56.123456
CS_BIGDATETIME_TYPE	8	2024-05-10 12:34:56.123456
CS_BIGDATETIME_TYPE	8	2024-05-10 12:34:56.123456
CS_BIGDATETIME_TYPE	8	2024-05-10 12:34:56.123456
SENDROW
CS_CHAR_TYPE	10	3
CS_DATETIME4_TYPE	4	2024-05-10 12:34:00
CS_DATETIME4_TYPE	4	2024-05-10 12:34:00
CS_DATETIME4_TYPE	4	2024-05-10 12:34:00
CS_DATETIME4_TYPE	4	2024-05-10 12:34:00
CS_DATETIME4_TYPE	4	2024-05-10 12:34:00
SENDROW
CS_CHAR_TYPE	10	4
CS_DATE_TYPE	4	2024-05-10
CS_TIME_TYPE	4	12:34:56.500
CS_BIGDATETIME_TYPE	8	9999-12-31 23:59:59.999999
CS_BIGDATETIME_TYPE	8	2024-05-10 23:59:59.999999
CS_BIGDATETIME_TYPE	8	1900-01-01 00:00:00.000001
SENDROW
CS_CHAR_TYPE	10	5
CS_BIGDATETIME_TYPE	8	1753-01-01 00:00:00.000000
CS_BIGTIME_TYPE	8	23:59:59.999999
CS_DATE_TYPE	4	2024-05-10
CS_TIME_TYPE	4	12:34:56.500
CS_BIGTIME_TYPE	8	12:34:56.123456
SENDROW
CS_CHAR_TYPE	10	6
CS_CHAR_TYPE	30	2024-05-10
CS_CHAR_TYPE	30	12:34:56.1234567
CS_CHAR_TYPE	30	2024-05-10 12:34:56.1234567
CS_CHAR_TYPE	30	2024-05-10 12:34:56.1234567
CS_CHAR_TYPE	30	2024-05-10 12:34:56.1234567
--
select
--
SELECT id, CONVERT(VARCHAR(40), d, 121), CONVERT(VARCHAR(40), t, 121), CONVERT(VARCHAR(40), dt2, 121),
	CONVERT(VARCHAR(40), dt2_3, 121), CONVERT(VARCHAR(40), dto, 121)
FROM all_types_bcp_unittest ORDER BY id
