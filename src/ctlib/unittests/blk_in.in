sql
--
-- date/time as strings, works also before TDS 7.3
CREATE TABLE all_types_bcp_unittest (
	  id		int NOT NULL
	, d		date NULL
	, t		time NULL
	, dt2		datetime2 NULL
	, dt2_3		datetime2(3) NULL
	, dto		datetimeoffset NULL
)
--
bind
--
CS_CHAR_TYPE	10	1
CS_CHAR_TYPE	40	2024-05-10
CS_CHAR_TYPE	40	12:34:56.1234567
CS_CHAR_TYPE	40	2024-05-10 12:34:56.1234567
CS_CHAR_TYPE	40	2024-05-10 12:34:56.123
CS_CHAR_TYPE	40	2024-05-10 12:34:56.1234567
SENDROW
CS_CHAR_TYPE	10	2
CS_CHAR_TYPE	40	9999-12-31
CS_CHAR_TYPE	40	23:59:59.9999999
CS_CHAR_TYPE	40	1753-01-01 00:00:00.0000000
CS_CHAR_TYPE	40	1900-01-01 00:00:00.001
CS_CHAR_TYPE	40	2024-05-10 23:59:59.9999999
--
select
--
SELECT id, CONVERT(VARCHAR(40), d, 121), CONVERT(VARCHAR(40), t, 121), CONVERT(VARCHAR(40), dt2, 121),
	CONVERT(VARCHAR(40), dt2_3, 121), CONVERT(VARCHAR(40), dto, 121)
FROM all_types_bcp_unittest ORDER BY id
--
output
--
1
2024-05-10
12:34:56.1234567
2024-05-10 12:34:56.1234567
2024-05-10 12:34:56.123
2024-05-10 12:34:56.1234567 +00:00
2
9999-12-31
23:59:59.9999999
1753-01-01 00:00:00.0000000
1900-01-01 00:00:00.001
2024-05-10 23:59:59.9999999 +00:00
