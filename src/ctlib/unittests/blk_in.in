--
sql
--
CREATE TABLE all_types_bcp_unittest (
	  n		nvarchar(10) COLLATE Latin1_General_CI_AS NOT NULL
)
--
bind
--
CS_CHAR_TYPE	30	hello
SENDROW
CS_CHAR_TYPE	30	world
--
select
--
SELECT n, CONVERT(VARBINARY(20), n) FROM all_types_bcp_unittest ORDER BY n
--
output
--
hello
680065006c006c006f00
world
77006f0072006c006400
--
end

